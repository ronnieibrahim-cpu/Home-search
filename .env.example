# Copy to .env for local runs. In GitHub Actions these are repository secrets.

# Sending the digest (Gmail SMTP with an app password, not your login password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
DIGEST_TO=

# Reading HAR / Redfin saved-search alert emails (same Gmail account, IMAP)
ALERT_GMAIL_LABEL=home-search

# CI only: the whole contents of config/profile.yaml, as one secret
# PROFILE_YAML=
